{:paths ["src" "resources"]

 :deps {com.stuartsierra/component        {:mvn/version "1.1.0"}
        com.zaxxer/HikariCP               {:mvn/version "5.0.1"
                                           :exclusions  [org.slf4j/slf4j-api]}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.909"}
        org.clojure/clojure               {:mvn/version "1.11.1"}
        org.clojure/tools.logging         {:mvn/version "1.3.0"}
        org.slf4j/slf4j-api               {:mvn/version "2.0.12"}
        org.slf4j/jcl-over-slf4j          {:mvn/version "2.0.12"}
        ch.qos.logback/logback-classic    {:mvn/version "1.5.3"}
        org.postgresql/postgresql         {:mvn/version "42.5.4"}
        ring/ring-core                    {:mvn/version "1.12.1"}
        ring/ring-jetty-adapter           {:mvn/version "1.12.1"}
        ring/ring-json                    {:mvn/version "0.5.1"}
        hiccup/hiccup                     {:mvn/version "2.0.0-RC3"}
        metosin/reitit                    {:mvn/version "0.6.0"}}

 :aliases {:dev {:extra-paths ["dev"]}

           :test {:extra-paths ["test"]
                  :extra-deps  {lambdaisland/kaocha                     {:mvn/version "1.87.1366"}
                                clj-http/clj-http                       {:mvn/version "3.13.0"}
                                clj-test-containers/clj-test-containers {:mvn/version "0.7.4"}}
                  :main-opts   ["-m" "kaocha.runner"]}

           :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.02.12"}}
                  :main-opts  ["-m" "clj-kondo.main" "--lint" "src:test"]}

           :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                    :main-opts  ["-m" "cljfmt.main" "--indents" "indentation.edn" "fix"]}}}
